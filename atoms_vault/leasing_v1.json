{
  "tamga_id": "018f15a2-8b3d-7c2a-9e4f-556677889900",
  "v_clock": 1,
  "service_name": "Приобретение вагонов в лизинг",
  "version": "1.0",
  "data_schema": {
    "applicant_iin_bin": {
      "type": "string",
      "label": "ИИН/БИН заявителя",
      "source": "egov_idp_mock",
      "editable": false
    },
    "company_age_years": {
      "type": "integer",
      "label": "Срок существования компании (лет)",
      "source": "egov_idp_mock",
      "editable": false
    },
    "wagon_type": {
      "type": "enum",
      "label": "Тип запрашиваемого вагона",
      "options": ["Полувагон", "Цистерна", "Зерновоз"],
      "editable": true
    },
    "wagon_count": {
      "type": "integer",
      "label": "Количество единиц",
      "editable": true,
      "validation": { "min": 1, "max": 50 }
    }
  },
  "business_logic": {
    "routing": [
      {
        "condition": "company_age_years < 2",
        "action": "set_status",
        "value": "MANUAL_RISK_REVIEW"
      },
      {
        "condition": "company_age_years >= 2",
        "action": "set_status",
        "value": "AUTO_SCORING"
      }
    ]
  }
}
